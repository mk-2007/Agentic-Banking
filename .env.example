# Copy this file to `.env` (same folder) and fill in your keys. `.env` is git-ignored: never commit it.
NEXA_ENV=dev

# Model providers. Having ONE key is enough; having both enables automatic failover.
GROQ_API_KEY=
GEMINI_API_KEY=

# Which providers to use and in what order (first is primary). Default: groq,gemini
# NEXA_LLM_PROVIDERS=groq,gemini

# Optional: override the default model. List what your keys can use with:
#   python scripts/llm_smoke_test.py --list-models
# NEXA_GROQ_MODEL=
# NEXA_GEMINI_MODEL=gemini-flash-latest   # the default; pin a specific model here if you prefer

# Optional: sign-ins for the HTTP API as token:user_id:role pairs (roles: fraud_analyst,
# risk_officer, compliance_officer, customer). Or run scripts/run_api.py --demo for random ones.
# NEXA_API_TOKENS=
